<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>COMP 2537 Assignment 2</title>
    <!-- Bootstrap CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Dynamic Custom CSS Input -->
    <% if (locals.styleSheets) { %>
        <% styleSheets.forEach(function(file) { %>
            <link rel="stylesheet" href="/css/<%= file %>.css">
        <% }); %>
    <% } %>
</head>
<body class="d-flex flex-column min-vh-100">

<header class="bg-white border-bottom shadow-sm py-3">
    <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center">
        <!-- Title: Always blue, centered on mobile, left-aligned on desktop -->
        <a href="/" class="fs-4 fw-bold text-primary text-decoration-none mb-2 mb-md-0">
            COMP 2537 Assignment 2
        </a>
        
        <!-- Navigation Links: No hamburger menu, always visible -->
        <nav>
            <ul class="nav justify-content-center">
                <li class="nav-item">
                    <a class="nav-link text-primary px-2" href="/">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-primary px-2" href="/members">Cats</a>
                </li>
                    <a class="nav-link" href="<%= authenticated ? '/logout' : '/login' %>">
                        <%= authenticated ? 'Logout' : 'Login' %>
                    </a>
                <li class="nav-item">
                    <a class="nav-link text-primary px-2" href="/admin">Admin</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-primary px-2" href="/does_not_exist">404</a>
                </li>
            </ul>
        </nav>
    </div>
</header>

<main class="container py-5">