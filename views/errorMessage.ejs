<%- include('templates/header', { styleSheets: [] }) %>

<div class="d-flex align-items-center justify-content-center" style="min-height: 60vh;">
    <div class="text-center">
        <h1 class="display-4 fw-bold text-danger mb-4">
            Error - <%= locals.statusCode ? statusCode : "" %>
        </h1>
        
        <!-- This displays the custom message passed from the route -->
        <p class="lead mb-5">
            <%= locals.error ? error : "An unexpected error occurred." %>
        </p>

        <a href="/" class="btn btn-primary btn-lg px-5">
            Return to Safety
        </a>
    </div>
</div>

<%- include('templates/footer', { scripts: [] }) %>